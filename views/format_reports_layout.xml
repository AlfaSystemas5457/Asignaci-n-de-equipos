<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <template id="dev_equipment_report_external_layout_template_equipment">
        <!-- <t t-call="web.basic_layout"> -->
        <t t-call="web.html_container">
            <t t-call="web.basic_layout">
                <style>
                    @page {
                    margin: 0mm !important;
                    size: A4;
                    }
                    html,
                    body {
                    height: 100% !important;
                    margin: 0px !important;
                    padding: 0px !important;
                    }
                </style>

                <div class="p-2">
                    <!-- Encabezado -->
                    <div class="oe_structure"></div>
                    <div name="header"
                        class="header mt-2 mx-2 position-absolute fixed-top"
                        style="z-index: 0 !important;">
                        <table
                            style="width: 100%; border: 1px solid; height: 130px; border-collapse: collapse;">
                            <tr>
                                <!-- Logo -->
                                <td
                                    style="width: 20%; text-align: center; height: 130px; vertical-align: middle; border: 1px solid;">
                                    <t t-if="docs">
                                        <img
                                            t-att-src="image_data_uri(docs.env.company.logo)"
                                            style="max-height: 50px;" alt="Logo" />
                                    </t>
                                    <t t-else="">
                                        <img
                                            t-att-src="image_data_uri(company.logo)"
                                            style="max-height: 50px;" alt="Logo" />
                                    </t>
                                </td>

                                <!-- Nombre de la empresa y del documento -->
                                <td
                                    style="width: 60%; border: 1px solid; height: 130px; text-align: center;">
                                    <div
                                        style="width:100%; height:100px; display:flex; flex-direction:column;">
                                        <div
                                            style="width:100%; height:50%; display:flex; text-align:center; vertical-align:middle; margin-bottom: 10px padding:20px;">
                                            <strong
                                                style="display: block; width: 100%; padding: 5px;">
                                                <t t-if="docs">
                                                    <t t-esc="docs.env.company.name" />
                                                </t>
                                                <t t-else="">
                                                    <t t-esc="company.name" />
                                                </t>
                                            </strong>
                                        </div>
                                        <div
                                            style="width:100%; height:100%; display:flex; text-align:center; vertical-align:middle; border-top: 1px solid; margin-top: 10px; padding:10px;">
                                            <span name="title"
                                                style="display: block; width: 100%; padding: 5px;">
                                                <t t-if="docs and docs._name == 'account.move'">
                                                    <t t-esc="docs.name" />
                                                </t>
                                                <t
                                                    t-elif="docs and docs._name == 'equipment.allocation'">
                                                    <t t-esc="docs.name" />
                                                </t>
                                                <t t-else="">
                                                </t>
                                            </span>
                                        </div>
                                    </div>
                                </td>

                                <!-- Información adicional -->
                                <td
                                    style="width: 20%; text-align: center; font-size: 12px; height: 130px; vertical-align: middle;">
                                    <table
                                        style="width: 100%; height: 100%; border-collapse: collapse;">
                                        <tr>
                                            <td
                                                style="padding: 5px; border-collapse: collapse;">
                                                <strong> Página: <span class="page" /> / <span
                                                        class="topage" />
                                                </strong>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td
                                                style="padding: 5px; border-collapse: collapse; border-top: 1px solid;">
                                                <strong>Revisión </strong>
                                                <span>1</span>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td
                                                style="padding: 5px; border-collapse: collapse; border-top: 1px solid;">
                                                <strong>Folio:</strong>
                                                <span>
                                                    <t
                                                        t-if="docs and docs._name == 'equipment.allocation'">
                                                        <t t-esc="docs.number" />
                                                    </t>
                                                    <t
                                                        t-elif="docs and docs.name">
                                                        <t t-esc="docs.name" />
                                                    </t>
                                                    <t t-else="">
                                                    </t>
                                                </span>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td
                                                style="padding: 5px; border-collapse: collapse; border-top: 1px solid;">
                                                <strong>Fecha:</strong>
                                                <t
                                                    t-if="docs and docs._name == 'equipment.allocation'">
                                                    <t
                                                        t-esc="docs.request_date.strftime('%d/%m/%Y')" />
                                                </t>
                                                <t t-elif="docs and docs.date">
                                                    <t
                                                        t-esc="docs.date.strftime('%d/%m/%Y')" />
                                                </t>
                                                <t t-else="">
                                                </t>
                                            </td>
                                        </tr>
                                    </table>
                                </td>
                            </tr>
                        </table>
                    </div>

                    <!-- Contenido -->
                    <div class="oe_structure"></div>
                    <div name="page"
                        style="flex-grow: 1; min-height: calc(100vh - 300px);">
                        <t t-call="web.address_layout" />
                        <h2 t-out="layout_document_title" />
                        <t t-out="0" />
                    </div>

                    <!-- Pie de página -->
                    <div class="oe_structure"></div>
                    <div name="footer" class="position-absolute fixed-bottom mb-2 mx-2"
                        style="text-align: center; border-bottom: 1px solid;">
                        <t t-if="docs">
                            <t t-esc="docs.env.company.report_footer" />
                        </t>
                        <t t-else="">
                            <t t-esc="company.report_footer" />
                        </t>
                    </div>
                </div>
            </t>
        </t>
    </template>

    <record id="report_layout_custom_mir" model="report.layout">
        <field name="name">Custom MIR</field>
        <field name="sequence">2</field>
        <field name="view_id"
            ref="dev_equipment_allocation.dev_equipment_report_external_layout_template_equipment" />
    </record>
</odoo>