<odoo>
    <record id="form_res_config_dev_equipment_allocation" model="ir.ui.view">
        <field name="name">form_res_config_dev_equipment_allocation_name</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='users_setting_container']" position="before">
                <h2>Equipment Return Reminder</h2>
                <div class="row mt16 o_settings_container">
                    <group>
                        <group>
                            <field name="er_before_days"/>
                        </group>
                    </group>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
