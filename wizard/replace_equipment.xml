<odoo>
    <record id="popup_replace_equipment_dev_equipment_allocation" model="ir.ui.view">
        <field name="name">popup_replace_equipment_dev_equipment_allocation_name</field>
        <field name="model">replace.equipment</field>
        <field name="arch" type="xml">
            <form string="Replace Equipment">
                <group>
                    <group>
                        <field name="equipment_id"/>
                        <field name="allocation_id" invisible="1"/>
                    </group>
                </group>
                <footer>
                    <button string="Request Replacement" name="replace_equipment" type="object" class="oe_highlight"/>&#160;&#160;or&#160;&#160;
                    <button string="Close Window" class="oe_link" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

	<record id="action_replace_equipment_dev_equipment_allocation" model="ir.actions.act_window">
        <field name="name">Replace Equipment</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">replace.equipment</field>
        <field name="context">{'default_allocation_id': active_id}</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="popup_replace_equipment_dev_equipment_allocation"/>
        <field name="target">new</field>
    </record>
</odoo>