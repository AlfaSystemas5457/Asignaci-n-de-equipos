<odoo>
    <record id="template_allocation_return_reminder" model="mail.template">
        <field name="name">Equipment Return Reminder</field>
        <field name="subject">({{object.number}})Equipment Request's return date is near</field>
        <field name="email_from">{{user.company_id.email or ''}}</field>
        <field name="email_to">{{object.employee_id and object.employee_id.work_email or ''}}</field>
        <field name="model_id" ref="dev_equipment_allocation.model_equipment_allocation"/>
        <field name="body_html"><![CDATA[
            <div style="background-color:#F3F5F6;color:#515166;font-family:Arial,Helvetica,sans-serif;font-size:14px;">
                <p>Hello,</p>
                <br/>
                <p>You need to return <strong><t t-out="object.equipment_id.name"></strong> on
                <strong><t t-out="object.get_return_date()"></strong></p>
                <br/>
                <a t-attf-href="{{object.allocation_url()}}"
                    style="background-color: #875A7B; padding: 8px 16px 8px 16px; text-decoration: none; color: #fff; border-radius: 5px; font-size:13px;"
                    target="_blank">
                    View Request
                </a>
                <br/><br/>
            </div>
        ]]></field>
    </record>
</odoo>